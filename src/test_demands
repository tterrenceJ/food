# ---------------------------------------------------------------------------
# compute_centroids
# ---------------------------------------------------------------------------

def test_compute_centroids_matches_box_center():
    gdf = gpd.GeoDataFrame(
        {"GEOID": ["999990000011"]},
        geometry=[box(10.00, 10.00, 10.01, 10.01)],
        crs="EPSG:4326",
    )
    out = compute_centroids(gdf, projected_crs="EPSG:3857")
    # a small, symmetric box's true centroid is its midpoint; EPSG:3857's y-nonlinearity
    # is negligible at this scale, so this should land within ~1e-6 degrees of it
    assert out.loc[0, "lon"] == pytest.approx(10.005, abs=1e-6)
    assert out.loc[0, "lat"] == pytest.approx(10.005, abs=1e-6)


def test_compute_centroids_output_is_finite():
    gdf = _bg_gdf()
    out = compute_centroids(gdf, projected_crs="EPSG:3857")
    assert out["lat"].notna().all()
    assert out["lon"].notna().all()
    assert out["lat"].between(-90, 90).all()
    assert out["lon"].between(-180, 180).all()


# ---------------------------------------------------------------------------
# build_demand_table — full pipeline
# ---------------------------------------------------------------------------

def test_build_demand_table_end_to_end():
    demand = build_demand_table(_acs_df(), _bg_gdf(), projected_crs="EPSG:3857")

    # D (TIGER-only) and E (ACS-only) must be dropped; only A, B, C survive
    assert len(demand) == 3
    assert set(demand["block_group_id"]) == {"999990000011", "999990000012", "999990000021"}

    assert list(demand.columns) == OUTPUT_COLUMNS

    row_a = demand.set_index("block_group_id").loc["999990000011"]
    assert row_a["population"] == 1000
    assert row_a["poverty_rate"] == pytest.approx(0.25)
    assert row_a["pct_no_vehicle"] == pytest.approx(0.10)
    assert row_a["tract_id"] == "99999000001"

    row_b = demand.set_index("block_group_id").loc["999990000012"]
    assert pd.isna(row_b["poverty_rate"])          # zero poverty universe
    assert row_b["pct_no_vehicle"] == pytest.approx(0.15)
    assert row_b["tract_id"] == "99999000001"       # same tract as A

    row_c = demand.set_index("block_group_id").loc["999990000021"]
    assert row_c["poverty_rate"] == pytest.approx(0.20)
    assert pd.isna(row_c["pct_no_vehicle"])         # zero occupied units
    assert row_c["tract_id"] == "99999000002"        # different tract from A/B


def test_build_demand_table_is_sorted_by_block_group_id():
    demand = build_demand_table(_acs_df(), _bg_gdf(), projected_crs="EPSG:3857")
    assert list(demand["block_group_id"]) == sorted(demand["block_group_id"])


def test_build_demand_table_tract_rollup_nests_exactly():
    """Phase 8 rolls block groups up to tracts assuming clean nesting — confirm
    tract_id really is just the block group's own GEOID, truncated, for every row."""
    demand = build_demand_table(_acs_df(), _bg_gdf(), projected_crs="EPSG:3857")
    assert (demand["tract_id"] == demand["block_group_id"].str[:11]).all()