def test_poverty_rate_normal_division():
    df = pd.DataFrame([{"poverty_universe": 1000, "poverty_count": 250}])
    out = compute_poverty_rate(df)
    assert out.loc[0, "poverty_rate"] == pytest.approx(0.25)


def test_poverty_rate_zero_universe_is_nan_not_zero():
    df = pd.DataFrame([{"poverty_universe": 0, "poverty_count": 0}])
    out = compute_poverty_rate(df)
    assert pd.isna(out.loc[0, "poverty_rate"])


def test_poverty_rate_nan_universe_is_nan():
    df = pd.DataFrame([{"poverty_universe": float("nan"), "poverty_count": 5}])
    out = compute_poverty_rate(df)
    assert pd.isna(out.loc[0, "poverty_rate"])


