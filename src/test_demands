"""
tests/test_build_demand.py — Phase 2 unit tests.

Every fixture here is synthetic and deliberately fake-looking (state FIPS "99",
county FIPS "999" — no real US county has these) so nothing in this file can ever
be mistaken for real Shelby County / Memphis data. That real data only exists once
you've run ingest_census.py yourself with a live API key; these tests exist to
prove build_demand.py's logic is correct *before* you spend that API call, and to
keep proving it every time you touch this file afterward.

Run with:
    pytest tests/test_build_demand.py -v
"""

from __future__ import annotations

import sys
from pathlib import Path

import geopandas as gpd
import pandas as pd
import pytest
from shapely.geometry import box

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from build_demand import (  # noqa: E402
    OUTPUT_COLUMNS,
    build_demand_table,
    compute_centroids,
    compute_pct_no_vehicle,
    compute_poverty_rate,
    reconstruct_geoid,
)

# ---------------------------------------------------------------------------
# Shared synthetic fixtures
# ---------------------------------------------------------------------------
# Three "real" block groups (A, B, C — present in both ACS and TIGER), plus one
# TIGER-only phantom (D) and one ACS-only phantom (E), to exercise the merge's
# mismatch handling. State "99" / county "999" are not real FIPS codes.

ACS_ROWS = [
    # GEOID          pop   pov_universe  pov_count  occ_units  owner_no_veh  renter_no_veh
    ("999990000011", 1000, 1000,          250,        400,        20,            20),   # A: normal case
    ("999990000012", 2000, 0,             0,          500,        50,            25),   # B: zero poverty universe
    ("999990000021", 500,  500,           100,        0,          0,             0),    # C: zero occupied units
    ("999990000041", 777,  777,           77,         100,        5,             5),    # E: ACS-only phantom
]


def _acs_df() -> pd.DataFrame:
    rows = []
    for geoid, pop, pov_u, pov_c, occ, own_nv, rent_nv in ACS_ROWS:
        rows.append({
            "state": geoid[0:2], "county": geoid[2:5], "tract": geoid[5:11], "block group": geoid[11:12],
            "area_name": f"Test Block Group {geoid}",
            "population_total": pop,
            "poverty_universe": pov_u,
            "poverty_count": pov_c,
            "occupied_units_total": occ,
            "owner_occupied_no_vehicle": own_nv,
            "renter_occupied_no_vehicle": rent_nv,
        })
    return pd.DataFrame(rows)


def _bg_gdf() -> gpd.GeoDataFrame:
    # Small, non-overlapping unit boxes near an arbitrary, clearly-non-Memphis
    # test coordinate (10E, 10N) — geometry only needs to be *valid*, not real.
    geoms = {
        "999990000011": box(10.00, 10.00, 10.01, 10.01),   # A
        "999990000012": box(10.02, 10.00, 10.03, 10.01),   # B
        "999990000021": box(10.00, 10.02, 10.01, 10.03),   # C
        "999990000031": box(10.02, 10.02, 10.03, 10.03),   # D: TIGER-only phantom
    }
    return gpd.GeoDataFrame(
        {"GEOID": list(geoms.keys())},
        geometry=list(geoms.values()),
        crs="EPSG:4326",
    )


# ---------------------------------------------------------------------------
# reconstruct_geoid
# ---------------------------------------------------------------------------

def test_reconstruct_geoid_basic():
    df = pd.DataFrame([{"state": "99", "county": "999", "tract": "000001", "block group": "1"}])
    out = reconstruct_geoid(df)
    assert out.loc[0, "GEOID"] == "999990000011"
    assert len(out.loc[0, "GEOID"]) == 12


def test_reconstruct_geoid_recovers_lost_leading_zeros():
    """Mirrors the exact bug hit for real in ingest_fara.py: a leading zero lost
    somewhere upstream (e.g. by round-tripping through a plain int) must be
    recoverable by zero-padding each piece to its correct fixed width."""
    df = pd.DataFrame([{"state": "5", "county": "7", "tract": "123", "block group": "1"}])
    out = reconstruct_geoid(df)
    assert out.loc[0, "GEOID"] == "050070001231"


def test_reconstruct_geoid_missing_column_raises():
    df = pd.DataFrame([{"state": "99", "county": "999", "block group": "1"}])  # no 'tract'
    with pytest.raises(KeyError):
        reconstruct_geoid(df)


